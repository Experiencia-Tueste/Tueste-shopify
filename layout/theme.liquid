{%- capture direction -%}{% render 'direction' %}{%- endcapture -%}
<!doctype html>
<html class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}" lang="{{ request.locale.iso_code }}" dir="{{ direction }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_button_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% # theme-check-disable RemoteAsset %}
    <link rel="dns-prefetch" href="https://ajax.googleapis.com">
    <link rel="dns-prefetch" href="https://maps.googleapis.com">
    <link rel="dns-prefetch" href="https://maps.gstatic.com">
    {% # theme-check-enable RemoteAsset %}

    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png" />
    {%- endif -%}

    <title>
      {{- page_title -}}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- if request.page_type == 'password' -%}
        {{- shop.name -}}
      {%- else -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- liquid
      render 'social-meta-tags'
      
      render 'css-variables'
      echo 'theme.css' | asset_url | stylesheet_tag: preload: true

      if template.suffix == 'tienda-editorial' or template.suffix == 'tueste-tree' or template.suffix == 'tueste-unity' or template.suffix == 'tueste-records'
        echo 'tienda-editorial.css' | asset_url | stylesheet_tag
      endif

      if request.page_type == 'index'
        echo 'tienda-editorial.css' | asset_url | stylesheet_tag
      endif

      if template.suffix == 'tienda-editorial' or template.suffix == 'tueste-tree' or template.suffix == 'tueste-unity' or template.suffix == 'tueste-records' or template.suffix == 'verificar' or template.suffix == 'certificado-arbol' or request.page_type == 'index'
        echo 'universo-tueste.css' | asset_url | stylesheet_tag
      endif

      if template.suffix == 'tueste-tree'
        echo 'tueste-tree-mockup.css' | asset_url | stylesheet_tag
      endif

      if template.suffix == 'tueste-records'
        echo 'tueste-records-extra.css' | asset_url | stylesheet_tag
      endif

      if template.suffix == 'tueste-unity'
        echo 'tueste-unity-extra.css' | asset_url | stylesheet_tag
      endif

      if direction == 'rtl'
        echo 'rtl.css' | asset_url | stylesheet_tag: preload: true
      endif
    -%}

    {%- if template.suffix == 'tienda-editorial' or template.suffix == 'tueste-tree' or template.suffix == 'tueste-unity' or template.suffix == 'tueste-records' or template.suffix == 'verificar' or template.suffix == 'certificado-arbol' or request.page_type == 'index' -%}
      {%- render 'tueste-fonts' -%}
      <style>
        @font-face {
          font-family: "Tueste Typeface";
          src: url('{{ 'tueste-typeface.ttf' | asset_url }}') format('truetype');
          font-display: swap;
          font-weight: 400 900;
          font-style: normal;
        }
        @font-face {
          font-family: "Archivo Black";
          src: url('{{ 'archivo-black.ttf' | asset_url }}') format('truetype');
          font-display: swap;
          font-weight: 900;
          font-style: normal;
        }
        @font-face {
          font-family: Poppins;
          src: url('{{ 'poppins-regular.ttf' | asset_url }}') format('truetype');
          font-display: swap;
          font-weight: 400;
          font-style: normal;
        }
        @font-face {
          font-family: Poppins;
          src: url('{{ 'poppins-semibold.ttf' | asset_url }}') format('truetype');
          font-display: swap;
          font-weight: 600 800;
          font-style: normal;
        }
        @font-face {
          font-family: Lora;
          src: url('{{ 'lora-italic.ttf' | asset_url }}') format('truetype');
          font-display: swap;
          font-weight: 400 700;
          font-style: italic;
        }
        @font-face {
          font-family: "DM Mono";
          src: url('{{ 'dm-mono-regular.ttf' | asset_url }}') format('truetype');
          font-display: swap;
          font-weight: 400 500;
          font-style: normal;
        }
      </style>
    {%- endif -%}

    <link rel="stylesheet" href="{{ 'apps.css' | asset_url }}" media="print" fetchpriority="low" onload="this.media='all'">

    {%- if template.suffix == 'tueste-unity' or template.suffix == 'tueste-records' -%}
      <link rel="stylesheet" href="{{ 'tueste-parity.css' | asset_url }}">
    {%- endif -%}

    {%- if template.suffix == 'tueste-tree' -%}
      <script src="{{ 'tueste-tree-mockup.js' | asset_url }}" defer></script>
    {%- endif -%}

    {{ content_for_header }}

    <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {%- if settings.enable_tab_attention -%}
      <script src="{{ 'tab-attention.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if request.page_type contains 'customers/' -%}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- render 'js-variables' -%}
  </head>

  <body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}{% if template.suffix == 'tienda-editorial' %} template-tienda-editorial{% endif %}{% if template.suffix == 'tueste-tree' %} template-tueste-tree{% endif %}{% if template.suffix == 'tueste-unity' %} template-tueste-unity{% endif %}{% if template.suffix == 'tueste-records' %} template-tueste-records{% endif %}{% if request.page_type == 'index' %} template-tueste-home{% endif %}{% if request.path == '/challenge' %} template-challange{% endif %}" data-rounded-button="{{ settings.rounded_button }}" data-rounded-input="{{ settings.rounded_input }}" data-rounded-block="{{ settings.rounded_block }}" data-rounded-card="{{ settings.rounded_card }}" data-button-hover="{{ settings.buttons_hover }}"{% if settings.enable_page_transition %} data-page-transition{% endif %}{% if settings.enable_lazy_image %} data-lazy-image{% endif %} data-title-animation data-page-rendering>
    <a class="sr-only skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- liquid
      assign tueste_universe_shell = false
      if template.suffix == 'tienda-editorial' or template.suffix == 'tueste-tree' or template.suffix == 'tueste-unity' or template.suffix == 'tueste-records' or request.page_type == 'index'
        assign tueste_universe_shell = true
      endif

      assign tueste_universe_header_shell = false
      if template.suffix == 'tienda-editorial' or template.suffix == 'tueste-tree' or template.suffix == 'tueste-unity' or template.suffix == 'tueste-records' or request.page_type == 'index'
        assign tueste_universe_header_shell = true
      endif

      if settings.enable_page_transition
        render 'loading-bar'
      endif
      
      render 'mouse-cursor'

      unless tueste_universe_header_shell
        sections 'header-group'
      endunless
      sections 'overlay-group'
    -%}

    <div class="page-container" id="PageContainer">
      <main class="main-content relative" id="MainContent" role="main">
        {%- if template.suffix == 'tueste-tree' -%}
          {%- comment -%}Tree renders its compact ritual bar inside the landing section.{%- endcomment -%}
        {%- elsif template.suffix == 'tueste-unity' -%}
          {%- render 'tueste-universo-header', current: 'unity' -%}
        {%- elsif template.suffix == 'tueste-records' -%}
          {%- render 'tueste-universo-header', current: 'records' -%}
        {%- endif -%}
        {{ content_for_layout }}
      </main>

      {%- unless tueste_universe_shell -%}
        <footer class="footer-group block w-full" is="footer-group">
          {%- sections 'footer-group' -%}
        </footer>
      {%- endunless -%}
    </div>

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'general.accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'general.accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {%- if request.design_mode == false and settings.preload_links -%}
      <script src="{{ 'instant-page.js' | asset_url }}" type="module" fetchpriority="low" defer="defer"></script>
    {%- endif -%}
  </body>
</html>
