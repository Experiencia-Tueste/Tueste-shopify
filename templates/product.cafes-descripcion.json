        "collapsible_tab_UqKABR": {
          "type": "collapsible_tab",
          "settings": {
            "opened": false,
            "style": "with-border",
            "icon": "none",
            "heading": "Carácteristicas",
            "content": "",
            "page": "",
            "liquid": "<style>\n  .specs-card {\n    background: transparent; /* sin caja blanca */\n    border: none;\n    padding: 0;\n  }\n  .specs-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 10px;\n  }\n  @media (min-width: 560px){\n    .specs-grid { grid-template-columns: 1fr 1fr; } /* 2 columnas desktop */\n  }\n  .spec-row {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 10px 12px;\n    border: 1px dashed #e5e7eb;\n    border-radius: 12px;\n    background: rgba(255,255,255,0.05); /* sutil transparencia */\n  }\n  .spec-ico {\n    width: 28px; height: 28px; flex: 0 0 28px;\n    display: grid; place-items: center;\n    border-radius: 10px;\n    background: #f6f7f8;\n    color: #6b7280;\n    font-size: 14px;\n  }\n  .spec-body { display: grid; gap: 2px; }\n  .spec-label {\n    font-size: 12px; line-height: 1;\n    color: #6b7280; letter-spacing: .2px;\n    text-transform: uppercase;\n  }\n  .spec-value {\n    font-size: 15px; color: #111827;\n    font-weight: 600;\n  }\n</style>\n\n{%- assign m = product.metafields.custom -%}\n\n<div class=\"specs-card\">\n  <div class=\"specs-grid\">\n\n    {%- if m.score != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">★</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Puntaje</div>\n        <div class=\"spec-value\">{{ m.score }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.altitude != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">⛰️</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Altura</div>\n        <div class=\"spec-value\">{{ m.altitude }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.region != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">📍</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Región</div>\n        <div class=\"spec-value\">{{ m.region }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.notes != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">🗒️</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Notas</div>\n        <div class=\"spec-value\">{{ m.notes }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.main_flavor != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">😋</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Sabor principal</div>\n        <div class=\"spec-value\">{{ m.main_flavor }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.type != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">☕</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Tipo</div>\n        <div class=\"spec-value\">{{ m.type }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.variety != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">🌱</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Variedad</div>\n        <div class=\"spec-value\">{{ m.variety }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.process != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">⚙️</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Proceso</div>\n        <div class=\"spec-value\">{{ m.process }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.body != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">⚖️</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Cuerpo</div>\n        <div class=\"spec-value\">{{ m.body }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.intensity != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">⚡</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Intensidad</div>\n        <div class=\"spec-value\">{{ m.intensity }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.acidity != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">🍊</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Acidez</div>\n        <div class=\"spec-value\">{{ m.acidity }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n    {%- if m.fermentation != blank -%}\n    <div class=\"spec-row\">\n      <div class=\"spec-ico\">🧪</div>\n      <div class=\"spec-body\">\n        <div class=\"spec-label\">Fermentación</div>\n        <div class=\"spec-value\">{{ m.fermentation }}</div>\n      </div>\n    </div>\n    {%- endif -%}\n\n  </div>\n</div>"
