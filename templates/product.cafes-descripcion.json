        "liquid_rHNtnA": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- assign sp_raw = product.metafields.custom.sound_profile -%}\n{%- if sp_raw != blank -%}\n  {%- assign sp = sp_raw.value | default: sp_raw | parse_json -%}\n{%- endif -%}\n\n{%- assign sp_label = sp.label  | default: 'AMOUR' -%}\n{%- assign sp_alias = sp.alias  | default: 'Frecuencia reservada' -%}\n{%- assign sp_hz    = sp.hz     | default: 528 -%}  \n{%- assign sp_color = sp.color  | default: '#FF5A8A' -%}\n{%- assign sp_audio = sp.audio  | default: '' -%}\n{%- assign card_id  = 'freq-card-' | append: product.id -%}\n\n<div id=\"{{ card_id }}\" class=\"freq-card\">\n  <div class=\"freq-card__head\">\n    <div class=\"freq-card__title\">\n      <span class=\"freq-card__dot\" style=\"background:{{ sp_color }}\"></span>\n      <span>Frecuencia del {{ sp_label }}</span>\n    </div>\n    <!-- Muestra SOLO el alias, no el número -->\n    <div class=\"freq-card__hz\" id=\"{{ card_id }}-hz\" data-alias=\"{{ sp_alias | escape }}\">\n      {{ sp_alias }}\n    </div>\n  </div>\n\n  <div class=\"freq-card__wave\">\n    <canvas id=\"{{ card_id }}-canvas\"></canvas>\n  </div>\n\n  <div class=\"freq-card__footer\">\n    <button id=\"{{ card_id }}-btn\" class=\"freq-card__btn\">▶︎ Reproducir</button>\n    <span class=\"freq-card__desc\">Café intervenido con frecuencias para estructurar el agua de la planta y/o cereza</span>\n  </div>\n</div>\n\n<script>\n(function(){\n  // Valores del JSON (no se imprimen visualmente)\n  const hzVal   = Number('{{ sp_hz }}') || 440;         // ← número oculto\n  const color   = '{{ sp_color }}';\n  const audio   = '{{ sp_audio | escape }}';\n  const cardId  = '{{ card_id }}';\n\n  const canvas  = document.getElementById(cardId+'-canvas');\n  const ctx     = canvas.getContext('2d');\n  const btn     = document.getElementById(cardId+'-btn');\n  const hzText  = document.getElementById(cardId+'-hz');\n\n  // Ajuste canvas\n  function resizeCanvas(){\n    canvas.width  = canvas.offsetWidth;\n    canvas.height = 120;\n  }\n  window.addEventListener('resize', resizeCanvas);\n  resizeCanvas();\n\n  // Animación de onda\n  let t = 0;\n  function drawWave(active){\n    ctx.clearRect(0,0,canvas.width,canvas.height);\n\n    // Fondo sutil claro\n    const grad = ctx.createLinearGradient(0,0,canvas.width,canvas.height);\n    grad.addColorStop(0,'rgba(255,255,255,0.20)');\n    grad.addColorStop(1,'rgba(255,255,255,0.30)');\n    ctx.fillStyle = grad; ctx.fillRect(0,0,canvas.width,canvas.height);\n\n    const amp   = active ? 24 : 10;\n    const k     = (hzVal/528) * 2.2;\n    const speed = active ? 0.10 : 0.03;\n\n    // Onda principal (glow)\n    ctx.beginPath();\n    for(let x=0;x<canvas.width;x++){\n      const y = canvas.height/2 + amp * Math.sin((x * 0.02 * k) + t);\n      x===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);\n    }\n    ctx.strokeStyle = color;\n    ctx.lineWidth   = 2;\n    ctx.shadowColor = color;\n    ctx.shadowBlur  = 14;\n    ctx.stroke();\n\n    // Onda secundaria translúcida (profundidad)\n    ctx.beginPath();\n    for(let x=0;x<canvas.width;x++){\n      const y = canvas.height/2 + (amp * .55) * Math.sin((x * 0.018 * k) - t*0.85);\n      x===0 ? ctx.moveTo(x,y) : ctx.lineTo(x,y);\n    }\n    ctx.strokeStyle = color + 'AA';\n    ctx.lineWidth   = 1.6;\n    ctx.shadowBlur  = 0;\n    ctx.stroke();\n\n    t += speed;\n    requestAnimationFrame(()=>drawWave(active));\n  }\n  drawWave(false);\n\n  // Audio (usar archivo si existe, si no generar tono)\n  let audioCtx=null, osc=null, gain=null, media=null, mediaNode=null, isPlaying=false;\n\n  function stopAll(){\n    isPlaying=false;\n    btn.textContent = '▶︎ Reproducir';\n    hzText.setAttribute('data-active','false');\n    drawWave(false);\n\n    if (osc){ try{osc.stop()}catch(e){} osc.disconnect(); osc=null; }\n    if (gain){ try{gain.disconnect()}catch(e){} gain=null; }\n    if (media){\n      media.pause(); media.currentTime = 0;\n      if (mediaNode){ try{ mediaNode.disconnect() }catch(e){} mediaNode=null; }\n      media = null;\n    }\n    if (audioCtx && audioCtx.state !== 'closed'){\n      // opcional cerrar\n    }\n  }\n\n  function play(){\n    isPlaying=true;\n    t = 0;\n    btn.textContent = '⏹ Detener';\n    hzText.setAttribute('data-active','true');\n    drawWave(true);\n\n    if (audio){\n      media = new Audio(audio);\n      media.crossOrigin = 'anonymous';\n      media.loop = true; media.volume = 0.6;\n      media.play().catch(()=>{});\n      try{\n        audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n        mediaNode = audioCtx.createMediaElementSource(media);\n        const g = audioCtx.createGain(); g.gain.value = 1.0;\n        mediaNode.connect(g).connect(audioCtx.destination);\n      }catch(e){}\n    } else {\n      audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n      osc  = audioCtx.createOscillator();\n      gain = audioCtx.createGain();\n      osc.type = 'sine';\n      osc.frequency.value = hzVal; // ← usamos el número oculto\n      gain.gain.value = 0.08;\n      osc.connect(gain).connect(audioCtx.destination);\n      osc.start();\n    }\n  }\n\n  btn.addEventListener('click', ()=> isPlaying ? stopAll() : play());\n  document.addEventListener('visibilitychange', ()=>{ if(document.hidden) stopAll(); });\n  window.addEventListener('beforeunload', stopAll);\n})();\n</script>\n\n<style>\n/* Estilo claro / glass minimal */\n#{{ card_id }}.freq-card{\n  background: rgba(255,255,255,0.65);\n  backdrop-filter: blur(14px) saturate(180%);\n  -webkit-backdrop-filter: blur(14px) saturate(180%);\n  border: 1px solid rgba(255,255,255,0.45);\n  border-radius: 18px;\n  padding: 16px;\n  box-shadow: 0 10px 28px rgba(0,0,0,0.08), inset 0 0 0 1px rgba(255,255,255,0.12);\n  max-width: 520px;\n}\n\n#{{ card_id }} .freq-card__head{\n  display:flex; align-items:center; justify-content:space-between;\n  gap:12px; margin-bottom:8px;\n}\n#{{ card_id }} .freq-card__title{\n  display:flex; align-items:center; gap:10px; font-weight:800; letter-spacing:.2px; text-transform:uppercase; font-size:14px; color:#0b0f1a;\n}\n#{{ card_id }} .freq-card__dot{\n  width:12px; height:12px; border-radius:999px; box-shadow:0 0 8px {{ sp_color }};\n}\n#{{ card_id }} .freq-card__hz{ font-size:12px; color:#6b7280; transition: all .3s ease; }\n#{{ card_id }} .freq-card__hz[data-active=\"true\"]{ color:#111; text-shadow: 0 0 8px {{ sp_color }}; }\n\n#{{ card_id }} .freq-card__wave canvas{\n  width:100%; height:120px; display:block;\n  border-radius: 14px;\n  background: rgba(255,255,255,0.25);\n  border: 1px dashed rgba(0,0,0,0.08);\n  box-shadow: inset 0 0 40px rgba(0,0,0,0.04);\n}\n\n#{{ card_id }} .freq-card__footer{\n  display:flex; align-items:center; gap:12px; margin-top:10px;\n}\n#{{ card_id }} .freq-card__btn{\n  appearance:none; cursor:pointer;\n  background: rgba(255,255,255,0.75);\n  border: 1px solid rgba(0,0,0,0.08);\n  color:#111827; padding:10px 16px; border-radius: 28px; font-weight:800; text-transform:uppercase; font-size:12px; letter-spacing:.6px;\n  transition: all .25s ease; box-shadow: 0 6px 18px rgba(0,0,0,0.08);\n}\n#{{ card_id }} .freq-card__btn:hover{ background: {{ sp_color }}; color:#fff; transform: translateY(-2px) scale(1.02); box-shadow: 0 10px 26px rgba(0,0,0,0.10); }\n#{{ card_id }} .freq-card__desc{ font-size:12px; color:#94a3b8; }\n</style>"
          }
