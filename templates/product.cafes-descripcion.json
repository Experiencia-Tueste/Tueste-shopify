            "liquid": "{%- assign cp = product.metafields.custom.cupping_profile.value -%}\n{%- assign chart_id = 'score-chart-' | append: product.id -%}\n\n  <canvas\n    id=\"{{ chart_id }}\"\n    data-labels='[\"Fragancia\",\"Sabor\",\"Acidez\",\"Cuerpo\",\"Uniformidad\",\"Taza limpia\",\"Puntaje catador\",\"Residual\",\"Balance\",\"Dulzura\"]'\n    data-values='[\n      {{ cp.values.fragrance   | default: 8.5 }},\n      {{ cp.values.flavor      | default: 8.75 }},\n      {{ cp.values.acidity     | default: 8.25 }},\n      {{ cp.values.body        | default: 8.5 }},\n      {{ cp.values.uniformity  | default: 10 }},\n      {{ cp.values.clean_cup   | default: 10 }},\n      {{ cp.values.cupper_score| default: 8.25 }},\n      {{ cp.values.aftertaste  | default: 8 }},\n      {{ cp.values.balance     | default: 8 }},\n      {{ cp.values.sweetness   | default: 9.25 }}\n    ]'>\n  </canvas>\n</div>\n\n<script>\n  (function loadChartJS(cb){\n    if (window.Chart) return cb();\n    var s=document.createElement('script');\n    s.src='https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js';\n    s.onload=cb; document.head.appendChild(s);\n  })(function initRadar(){\n    const el = document.getElementById('{{ chart_id }}');\n    if (!el) return;\n    const labels = JSON.parse(el.getAttribute('data-labels'));\n    const values = JSON.parse(el.getAttribute('data-values'));\n\n    new Chart(el.getContext('2d'), {\n      type: 'radar',\n      data: {\n        labels,\n        datasets: [{\n          data: values,\n          fill: true,\n          backgroundColor: 'rgba(0,181,179,0.15)',\n          borderColor: '#00B5B3',\n          borderWidth: 2,\n          pointBackgroundColor: '#F3FFBD',\n          pointRadius: 4\n        }]\n      },\n      options: {\n        plugins: { legend: { display:false } },\n        scales: {\n          r: {\n            suggestedMin: 0, suggestedMax: 10,\n            ticks: { stepSize: 2, backdropColor:'transparent' },\n            grid: { color: '#e5e7eb' }, angleLines:{ color:'#e5e7eb' },\n            pointLabels: { font: { size: 12 }, color:'#374151' }\n          }\n        }\n      }\n    });\n  });\n</script>"
