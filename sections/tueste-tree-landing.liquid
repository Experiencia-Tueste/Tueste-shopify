{%- liquid
  assign hero_image = 'tueste-tree-hero-vitral.webp' | asset_url
  assign siembra_image = 'tueste-tree-siembra-vitral.webp' | asset_url
  assign certificate_image = 'tueste-tree-card1-ref.webp' | asset_url
  assign tree_logo = 'tueste-tree-logo-crema.png' | asset_url
  assign badge_seed = 'tueste-tree-insignia-1-semilla.webp' | asset_url
  assign badge_silver = 'tueste-tree-insignia-10-plata.webp' | asset_url
  assign badge_gold = 'tueste-tree-insignia-20-oro.webp' | asset_url
  assign badge_holographic = 'tueste-tree-insignia-30-holografica.webp' | asset_url
  assign benefits = section.settings.benefits | split: '||'
  assign adoption_price_label = 'Consultar'
  assign adoption_product = all_products[section.settings.adoption_product_handle]
  assign product_form_id = 'TuesteTreeForm-' | append: section.id
  assign founder_count_number = section.settings.founder_count | plus: 0
  assign founder_total_number = section.settings.founder_total | plus: 0
  capture founder_count_display
    render 'format-thousands', number: founder_count_number
  endcapture
  capture founder_total_display
    render 'format-thousands', number: founder_total_number
  endcapture
  if adoption_product != blank
    assign adoption_variant = adoption_product.selected_or_first_available_variant
    assign adoption_price_value = adoption_variant.price | divided_by: 100
    assign adoption_price_label = adoption_price_value | append: ' ' | append: shop.currency
  endif
-%}

{{ 'tueste-tree-landing.css' | asset_url | stylesheet_tag }}

<section
  id="TuesteTree-{{ section.id }}"
  class="tueste-tree-landing"
  data-tueste-tree
  data-price="{{ adoption_price_label | escape }}"
  data-total-founders="{{ section.settings.founder_total | escape }}"
  data-initial-founders="{{ section.settings.founder_count | escape }}"
  data-storage-key="tueste-tree-guardian"
  data-whatsapp="{{ section.settings.whatsapp_number | escape }}"
  data-badge-seed="{{ badge_seed }}"
  data-badge-silver="{{ badge_silver }}"
  data-badge-gold="{{ badge_gold }}"
  data-badge-holographic="{{ badge_holographic }}"
  style="--tt-hero-image: url('{{ hero_image }}'); --tt-siembra-image: url('{{ siembra_image }}');"
>
  <header class="tt-bar" aria-label="Progreso de Tueste Tree">
    <div class="tt-container tt-bar-row">
      <a class="tt-bar-logo" href="{{ routes.root_url }}" aria-label="Tueste, inicio">
        <img src="{{ 'tueste-logo-glass.png' | asset_url }}" alt="Tueste" width="700" height="242">
      </a>
      <div class="tt-steps" aria-label="Progreso del ritual" role="list">
        <i class="is-current" data-step-dot="0" role="listitem"></i>
        <i data-step-dot="1" role="listitem"></i>
        <i data-step-dot="2" role="listitem"></i>
        <i data-step-dot="3" role="listitem"></i>
        <i data-step-dot="4" role="listitem"></i>
      </div>
      <div class="tt-bar-count"><strong data-founder-count>{{ founder_count_display }}</strong> de {{ founder_total_display }} fundadores</div>
    </div>
  </header>

  <div class="tt-hero tt-section-pad" data-step="0">
    <img
      class="tt-hero-image"
      src="{{ hero_image }}"
      alt="Amanecer sobre el cafetal de la Finca Tres Esquinas"
      width="1600"
      height="900"
      fetchpriority="high"
    >
    <div class="tt-hero-overlay" aria-hidden="true"></div>
    <div class="tt-container tt-hero-content">
      <p class="tt-kicker">{{ section.settings.hero_eyebrow | escape }}</p>
      <h1>{{ section.settings.hero_title }}</h1>
      <p class="tt-lead">{{ section.settings.hero_lead | escape | newline_to_br }}</p>
      <div class="tt-button-row">
        <button class="tt-button tt-button--primary" type="button" data-enter-finca>{{ section.settings.hero_button | escape }} <span aria-hidden="true">→</span></button>
        <a class="tt-text-link" href="#promesa">{{ section.settings.hero_secondary_link | escape }}</a>
      </div>
      <div class="tt-founder-meter" aria-live="polite">
        <div class="tt-founder-numbers"><span><strong data-founder-count>{{ founder_count_display }}</strong> {{ section.settings.founder_label | escape }}</span><span>{{ founder_total_display }}</span></div>
        <div class="tt-meter" aria-hidden="true"><span data-progress-meter></span></div>
        <p>{{ section.settings.founder_note | escape }}</p>
      </div>
    </div>
  </div>

  <div class="tt-step tt-section-pad" data-step="1" hidden>
    <div class="tt-container">
      <div class="tt-section-heading">
        <p class="tt-kicker">Paso 1 · El lote</p>
        <h2>{{ section.settings.map_title }}</h2>
        <p class="tt-lead">{{ section.settings.map_lead | escape | newline_to_br }}</p>
      </div>
      <div class="tt-map-layout">
        <div class="tt-lot" data-lot>
          <div class="tt-lot-terrace" aria-hidden="true"></div>
          <div class="tt-lot-legend" aria-label="Estados del lote">
            <span><i class="tt-legend-dot tt-legend-dot--taken"></i>Con guardián</span>
            <span><i class="tt-legend-dot tt-legend-dot--free"></i>Libre</span>
            <span><i class="tt-legend-dot tt-legend-dot--mine"></i>El tuyo</span>
          </div>
          <div class="tt-tree-grid" role="group" aria-label="Mapa editorial del lote fundacional" data-tree-grid></div>
          <p class="tt-editorial-note">{{ section.settings.map_editorial_note | escape }}</p>
        </div>
        <div class="tt-selection-card" data-selection-card>
          <p class="tt-selection-label">Tu árbol</p>
          <strong class="tt-selection-number" data-selection-number><span class="tt-placeholder">Toca un punto libre</span></strong>
          <dl class="tt-facts">
            <div><dt>Lote</dt><dd>Fundacional · 10.200 árboles</dd></div>
            <div><dt>Finca</dt><dd>Tres Esquinas, hogar de Casa Cántara</dd></div>
            <div><dt>Altura</dt><dd>1.840 msnm · Paisaje Cultural Cafetero</dd></div>
            <div><dt>Variedad</dt><dd data-selection-variety>—</dd></div>
          </dl>
          <button class="tt-button tt-button--primary" type="button" data-to-plant disabled>Ir a sembrar <span aria-hidden="true">→</span></button>
        </div>
      </div>
    </div>
  </div>

  <div class="tt-step tt-section-pad" data-step="2" hidden>
    <div class="tt-container">
      <div class="tt-section-heading">
        <p class="tt-kicker">Paso 2 · La siembra</p>
        <h2>{{ section.settings.plant_title }}</h2>
        <p class="tt-lead">{{ section.settings.plant_lead | escape | newline_to_br }}</p>
      </div>
      <div class="tt-planting" data-planting>
        <img
          class="tt-planting-image"
          src="{{ siembra_image }}"
          alt="Vitral de la siembra en la Finca Tres Esquinas"
          width="1200"
          height="900"
          loading="lazy"
        >
        <canvas class="tt-seeds" data-seeds aria-hidden="true"></canvas>
        <button class="tt-hold-button" type="button" data-hold-to-plant aria-label="Mantén presionado para sembrar">
          <svg viewBox="0 0 196 196" aria-hidden="true"><circle class="tt-hold-track" cx="98" cy="98" r="91"></circle><circle class="tt-hold-progress" data-hold-progress cx="98" cy="98" r="91"></circle></svg>
          <span><strong>Sembrar</strong>mantén presionado</span>
        </button>
        <div class="tt-sprout" aria-hidden="true"><img src="{{ certificate_image }}" alt="" width="640" height="853" loading="lazy"></div>
      </div>
      <div class="tt-planted-message" data-planted-message hidden>
        <p class="tt-kicker">Sembrado</p>
        <p>{{ section.settings.planted_message | escape }}</p>
        <button class="tt-button tt-button--primary" type="button" data-to-name>Ponerle nombre <span aria-hidden="true">→</span></button>
      </div>
    </div>
  </div>

  <div class="tt-step tt-section-pad" data-step="3" hidden>
    <div class="tt-container tt-narrow-container">
      <div class="tt-section-heading">
        <p class="tt-kicker">Paso 3 · El nombre</p>
        <h2>{{ section.settings.name_title }}</h2>
        <p class="tt-lead">{{ section.settings.name_lead | escape | newline_to_br }}</p>
      </div>
      <div class="tt-name-form">
        <label class="tt-field"><span>Nombre del guardián</span><input type="text" maxlength="40" autocomplete="name" data-guardian-name placeholder="{{ section.settings.guardian_placeholder | escape }}"></label>
        <label class="tt-field"><span>Nombre del árbol (opcional)</span><input type="text" maxlength="30" data-tree-name placeholder="{{ section.settings.tree_name_placeholder | escape }}"></label>
        <div class="tt-form-actions">
          <button class="tt-button tt-button--primary" type="button" data-to-certificate disabled>Ver mi certificado <span aria-hidden="true">→</span></button>
          <p>{{ section.settings.name_helper | escape }}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="tt-step tt-section-pad" data-step="4" hidden>
    <div class="tt-container">
      <div class="tt-section-heading">
        <p class="tt-kicker">Paso 4 · Tu certificado</p>
        <h2>{{ section.settings.certificate_title }}</h2>
      </div>
      <div class="tt-certificate-layout">
        <article class="tt-certificate" data-certificate>
          <div class="tt-certificate-dots tt-certificate-dots--left" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="tt-certificate-dots tt-certificate-dots--right" aria-hidden="true"><i></i><i></i><i></i></div>
          <img class="tt-certificate-logo" src="{{ tree_logo }}" alt="Tueste Tree" width="160" height="55" loading="lazy">
          <p class="tt-certificate-kicker">Certificado de tradición</p>
          <p class="tt-certificate-subtitle">Tueste Tree · Adopción de origen</p>
          <h3>{{ section.settings.certificate_heading }}</h3>
          <img src="{{ certificate_image }}" alt="Ilustración Tueste Tree" width="640" height="853" loading="lazy">
          <hr>
          <p class="tt-certificate-lot">Lote fundacional · Founders</p>
          <p class="tt-certificate-number" data-certificate-number>ÁRBOL N.° 000000</p>
          <dl>
            <div><dt>Guardián</dt><dd data-certificate-name>—</dd></div>
            <div><dt>Nombre del árbol</dt><dd data-certificate-tree>—</dd></div>
            <div><dt>Cantidad</dt><dd data-certificate-quantity>1 árbol fundacional</dd></div>
            <div><dt>Fecha de siembra</dt><dd data-certificate-date>—</dd></div>
            <div><dt>Origen</dt><dd>Finca Tres Esquinas · Cañón de Aures · 1.840 msnm</dd></div>
          </dl>
          <p class="tt-certificate-note">{{ section.settings.certificate_note | escape }}</p>
          <button type="button" class="tt-button tt-button--secondary tt-certificate-download" data-download-certificate>Descargar certificado <span aria-hidden="true">↓</span></button>
        </article>

        <aside class="tt-adoption-panel">
          <p class="tt-kicker">Activa tu árbol fundacional</p>
          <div class="tt-price"><strong>{{ adoption_price_label | escape }}</strong><span>{{ section.settings.price_suffix | escape }}</span></div>
          <p class="tt-purchase-lead">{{ section.settings.purchase_lead | escape | newline_to_br }}</p>
          <ul class="tt-benefits">
            {%- for benefit in benefits -%}<li>{{ benefit | escape }}</li>{%- endfor -%}
          </ul>
          {%- comment -%}
            El <form> real necesita envolver la tarjeta de cantidad y el botón
            de compra para que sean descendientes de verdad: el custom
            element product-form (theme.js) busca su botón submit con
            this.querySelector('[type="submit"]'), que solo mira dentro del
            form, no un control asociado solo por atributo form="". Liquid
            exige anidamiento estricto (if/form no pueden interleavearse), así
            que este bloque se captura una sola vez y se imprime dentro del
            form cuando hay producto real, o suelto (sin form, botón
            deshabilitado) cuando el handle del schema todavía no existe.
          {%- endcomment -%}
          {%- capture buy_widget -%}
            <div class="tt-quantity-card">
              <label for="TuesteTreeQuantity-{{ section.id }}">¿Cuántos árboles adoptas?</label>
              <div class="tt-quantity-row">
                <div class="tt-stepper" role="group" aria-label="Cantidad de árboles">
                  <button type="button" data-quantity-minus aria-label="Un árbol menos">−</button>
                  <input id="TuesteTreeQuantity-{{ section.id }}" type="number" name="quantity" min="1" max="30" value="1" inputmode="numeric" data-quantity aria-label="Cantidad">
                  <button type="button" data-quantity-plus aria-label="Un árbol más">+</button>
                </div>
              <div class="tt-total"><strong data-quantity-total>{{ adoption_price_label | escape }}</strong><span data-quantity-label>· 1 árbol fundacional</span></div>
              </div>
              <div class="tt-current-badge" data-current-badge>
                <img src="{{ badge_seed }}" alt="Insignia Tueste Tree" width="440" height="607" data-current-badge-image loading="lazy">
                <div><span>Tu insignia</span><strong data-current-badge-name>SEMILLA</strong><p data-current-badge-description></p></div>
              </div>
              <p class="tt-quantity-hint">{{ section.settings.quantity_hint | escape }}</p>
              <div class="tt-agent-note" data-agent-note hidden>
                <strong>¿Quieres más de 30 árboles?</strong>
                <p>{{ section.settings.agent_body | escape }}</p>
                <a class="tt-button tt-button--secondary" data-whatsapp-link href="https://wa.me/{{ section.settings.whatsapp_number | remove: ' ' | remove: '+' }}" target="_blank" rel="noopener">Hablar con nuestro agente <span aria-hidden="true">→</span></a>
              </div>
            </div>
            <div class="tt-button-row">
              <button type="submit" name="add" class="tt-button tt-button--primary" data-buy-link{% if adoption_variant == blank %} disabled aria-disabled="true"{% endif %}>{{ section.settings.cta_label | escape }} <span aria-hidden="true">→</span></button>
              <button class="tt-button tt-button--secondary" type="button" data-share>Compartir mi árbol</button>
            </div>
          {%- endcapture -%}
          {%- if adoption_variant != blank -%}
            {%- form 'product', adoption_product, id: product_form_id, is: 'product-form', class: 'tt-buy-form', data-tree-buy-form: true -%}
              <input type="hidden" name="id" value="{{ adoption_variant.id }}" disabled>
              <input type="hidden" name="properties[Guardián]" value="" data-property-guardian>
              <input type="hidden" name="properties[Número de árbol]" value="" data-property-tree-number>
              <input type="hidden" name="properties[Insignia]" value="" data-property-badge>
              <div class="product-form__error-message alert alert--error tt-form-error" role="alert" hidden></div>
              {{ buy_widget }}
            {%- endform -%}
          {%- else -%}
            {{ buy_widget }}
          {%- endif -%}
          <p class="tt-secure-note">{{ section.settings.secure_note | escape }}</p>
          <p class="tt-legal-note">{{ section.settings.disclaimer | escape }}</p>
        </aside>
      </div>
    </div>
  </div>

  <section class="tt-badges tt-section-pad" id="insignias" data-section="tt-badges">
    <div class="tt-container">
      <div class="tt-section-heading">
        <p class="tt-kicker">Las insignias del proyecto</p>
        <h2>{{ section.settings.badges_title }}</h2>
        <p class="tt-lead">{{ section.settings.badges_lead | escape | newline_to_br }}</p>
      </div>
      <div class="tt-badge-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' -%}
            {%- assign badge_asset = badge_seed -%}
            {%- if block.settings.image_key == 'silver' -%}{%- assign badge_asset = badge_silver -%}{%- endif -%}
            {%- if block.settings.image_key == 'gold' -%}{%- assign badge_asset = badge_gold -%}{%- endif -%}
            {%- if block.settings.image_key == 'holographic' -%}{%- assign badge_asset = badge_holographic -%}{%- endif -%}
            <article class="tt-badge-card" data-badge-card data-badge-threshold="{{ block.settings.threshold | escape }}" {{ block.shopify_attributes }}>
              <img src="{{ badge_asset }}" alt="{{ block.settings.name | escape }}" width="440" height="605" loading="lazy">
              <p>{{ block.settings.threshold | escape }}<small>{{ block.settings.badge_label | escape }}</small></p>
              <h3>{{ block.settings.name | escape }}</h3>
              <div>{{ block.settings.description | escape }}</div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="tt-chapters tt-section-pad" id="promesa" data-section="tt-chapters">
    <div class="tt-container">
      <div class="tt-section-heading">
        <p class="tt-kicker">Vivir el café · el año de tu árbol</p>
        <h2>{{ section.settings.chapters_title }}</h2>
        <p class="tt-lead">{{ section.settings.chapters_lead | escape | newline_to_br }}</p>
      </div>
      <div class="tt-chapter-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'chapter' -%}
            {%- assign chapter_asset = 'tueste-tree-cap1-lluvia.webp' | asset_url -%}
            {%- if block.settings.image_key == 'cap2' -%}{%- assign chapter_asset = 'tueste-tree-cap2-flor.webp' | asset_url -%}{%- endif -%}
            {%- if block.settings.image_key == 'cap3' -%}{%- assign chapter_asset = 'tueste-tree-cap3-cosecha.webp' | asset_url -%}{%- endif -%}
            {%- if block.settings.image_key == 'cap4' -%}{%- assign chapter_asset = 'tueste-tree-cap4-taza.webp' | asset_url -%}{%- endif -%}
            <article class="tt-chapter-card" {{ block.shopify_attributes }}>
              <div class="tt-chapter-art"><img src="{{ chapter_asset }}" alt="{{ block.settings.image_alt | escape }}" width="420" height="420" loading="lazy"></div>
              <p class="tt-chapter-label">{{ block.settings.label | escape }}</p>
              <h3>{{ block.settings.title | escape }}</h3>
              <p>{{ block.settings.body | escape }}</p>
              <div class="tt-chapter-deliverable"><span>{{ block.settings.deliverable_label | escape }}</span>{{ block.settings.deliverable | escape }}</div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <p class="tt-quote">{{ section.settings.chapters_quote | escape }}</p>
    </div>
  </section>

  <footer class="tt-tree-footer">
    <img class="tt-tree-footer__logo" src="{{ tree_logo }}" alt="Tueste Tree" width="190" height="66" loading="lazy">
    <p>Tueste Tree · Un proyecto de Monacua Global Company S.A.S. · Paisaje Cultural Cafetero, Colombia</p>
    <small>{{ section.settings.footer_disclaimer | escape }}</small>
  </footer>

  <div class="tt-toast" data-toast role="status" aria-live="polite"></div>
</section>

<script src="{{ 'tueste-tree-certificate.js' | asset_url }}" defer></script>
<script src="{{ 'tueste-tree-landing.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Tueste Tree landing",
  "tag": "section",
  "class": "section-tueste-tree-landing",
  "limit": 1,
  "settings": [
    { "type": "text", "id": "progress_suffix", "label": "Texto después del contador", "default": "ya tienen su árbol" },
    { "type": "number", "id": "founder_count", "label": "Fundadores actuales", "default": 3570 },
    { "type": "number", "id": "founder_total", "label": "Total de fundadores", "default": 10200 },
    { "type": "text", "id": "founder_label", "label": "Etiqueta del avance", "default": "fundadores ya tienen su árbol" },
    { "type": "text", "id": "founder_note", "label": "Nota del avance", "default": "El 35 % del lote fundacional ya tiene guardián. La ventana fundacional no se vuelve a abrir." },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow del hero", "default": "Finca Tres Esquinas · Cañón de Aures · 1.840 msnm" },
    { "type": "inline_richtext", "id": "hero_title", "label": "Título del hero", "default": "Siembra un árbol. <em>Cofunda un origen.</em>" },
    { "type": "textarea", "id": "hero_lead", "label": "Descripción del hero", "default": "Los primeros 10.200 árboles de Tueste Tree son fundacionales: quienes entran ahora no adoptan, cofundan. Entra a la finca, elige tu lugar en el lote y siembra con tus manos el árbol que llevará tu nombre." },
    { "type": "text", "id": "hero_button", "label": "Botón principal del hero", "default": "Entrar a la finca" },
    { "type": "text", "id": "hero_secondary_link", "label": "Enlace secundario del hero", "default": "Qué recibe un fundador" },
    { "type": "inline_richtext", "id": "map_title", "label": "Título del mapa", "default": "Elige tu lugar <em>en la tierra.</em>" },
    { "type": "textarea", "id": "map_lead", "label": "Descripción del mapa", "default": "Cada punto es un árbol editorial de la Finca Tres Esquinas. Los ámbar ya tienen guardián. Toca uno libre: ese será tu árbol, con su número, su lote y su historia." },
    { "type": "text", "id": "map_editorial_note", "label": "Nota editorial del mapa", "default": "Experiencia visual · los estados no representan disponibilidad real" },
    { "type": "inline_richtext", "id": "plant_title", "label": "Título de siembra", "default": "Mantén presionado. <em>Siente cómo arraiga.</em>" },
    { "type": "textarea", "id": "plant_lead", "label": "Descripción de siembra", "default": "Sembrar un cafeto toma un gesto y años de paciencia. Aquí solo te pedimos el gesto: presiona y no sueltes hasta que la tierra lo reciba." },
    { "type": "text", "id": "planted_message", "label": "Mensaje después de sembrar", "default": "Tu árbol ya está en la tierra. Ahora, dale un nombre." },
    { "type": "inline_richtext", "id": "name_title", "label": "Título del nombre", "default": "Todo origen <em>tiene un guardián.</em>" },
    { "type": "textarea", "id": "name_lead", "label": "Descripción del nombre", "default": "Tu nombre quedará en el certificado de tradición de este árbol. Si lo adoptas para alguien más, escribe el suyo: es un regalo con historia, número y cosecha." },
    { "type": "text", "id": "guardian_placeholder", "label": "Placeholder guardián", "default": "Ej. María Fernanda López" },
    { "type": "text", "id": "tree_name_placeholder", "label": "Placeholder nombre árbol", "default": "Ej. Raíz, Aurora, Abuelo Jairo…" },
    { "type": "text", "id": "name_helper", "label": "Ayuda del formulario", "default": "Prometemos menos, cumplimos siempre: café del lote donde vive tu árbol, cosecha tras cosecha." },
    { "type": "inline_richtext", "id": "certificate_title", "label": "Título certificado", "default": "Este árbol <em>ya tiene guardián.</em>" },
    { "type": "inline_richtext", "id": "certificate_heading", "label": "Título interno certificado", "default": "Este árbol ya tiene <em>guardián.</em>" },
    { "type": "text", "id": "certificate_note", "label": "Nota certificado", "default": "Vista previa. El certificado numerado definitivo se emite al activar la adopción." },
    { "type": "text", "id": "adoption_product_handle", "label": "Handle del producto real", "default": "adopcion-digital-tueste-tree", "info": "El precio y el enlace salen de la variante disponible de este producto." },
    { "type": "text", "id": "price_suffix", "label": "Texto del precio", "default": "por árbol · pago único" },
    { "type": "textarea", "id": "purchase_lead", "label": "Descripción de compra", "default": "Entrar ahora te hace socio fundador, no solo adoptante. Los primeros 10.200 árboles cofundan Tueste Tree y participan de lo que el proyecto construya." },
