{%- liquid
  assign unity_logo = 'tueste-unity-logo.png' | asset_url
  assign tree_page = pages['tueste-tree']
  assign tree_url = tree_page.url | default: '/pages/tueste-tree'
  unless tree_url contains 'view=tueste-tree'
    assign tree_url = tree_url | append: '?view=tueste-tree'
  endunless
  assign tree_badge_image = 'tueste-tree-insignia-30-holografica.webp' | asset_url
  assign form_id = 'TuesteUnityContact-' | append: section.id
  assign path_blocks = section.blocks | where: 'type', 'path'
  assign timeline_blocks = section.blocks | where: 'type', 'timeline_step'
  assign hero_badges = section.settings.hero_badges | split: '||'
  assign hero_checklist = section.settings.hero_checklist | split: '||'
  assign crew_range = section.settings.crew_range | split: '||'
  assign tree_wa_text = 'Hola, quiero sumar árboles de Tueste Tree para mi empresa' | url_encode
  assign tree_wa_href = 'https://wa.me/' | append: section.settings.tree_whatsapp_number | append: '?text=' | append: tree_wa_text
  assign crew_wa_1_text = 'Hola Tueste Crew, quiero cotizar una ' | append: section.settings.crew_format_1_title | url_encode
  assign crew_wa_1_href = 'https://wa.me/' | append: section.settings.whatsapp_number | append: '?text=' | append: crew_wa_1_text
  assign crew_wa_2_text = 'Hola Tueste Crew, quiero cotizar una ' | append: section.settings.crew_format_2_title | url_encode
  assign crew_wa_2_href = 'https://wa.me/' | append: section.settings.whatsapp_number | append: '?text=' | append: crew_wa_2_text
  assign crew_wa_3_text = 'Hola Tueste Crew, quiero cotizar una experiencia de café a la medida. Cuéntame la fecha, el lugar y cuántas personas.' | url_encode
  assign crew_wa_3_href = 'https://wa.me/' | append: section.settings.whatsapp_number | append: '?text=' | append: crew_wa_3_text
-%}

<section class="universo-page tu-unity" data-tueste-unity id="TuesteUnity-{{ section.id }}" data-whatsapp="{{ section.settings.whatsapp_number | escape }}" data-email="{{ section.settings.contact_email | escape }}" data-tree-url="{{ tree_url | escape }}">
  {% render 'universo-tueste', current: 'unity' %}

  <div class="tu-wrap tu-section">
    <div class="tu-unity__intro">
      <div>
        <p class="tu-kicker">Tueste Unity · marcas con origen</p>
        <h1>{{ section.settings.title }}</h1>
        <p class="tu-lead">{{ section.settings.intro | escape }}</p>
        <div class="tu-hero__actions">
          <a class="tu-button tu-button--primary" href="#taller">{{ section.settings.primary_cta | escape }} <span aria-hidden="true">→</span></a>
          <a class="tu-button tu-button--ghost" href="#caminos">{{ section.settings.paths_cta_label | escape }}</a>
          <a class="tu-button tu-button--ghost" href="#taller" data-unity-goto-step="5">Hablar con Unity</a>
        </div>
        {%- if hero_badges.size > 0 -%}
          <ul class="tu-unity__specs" aria-label="Datos del café">
            {%- for badge in hero_badges -%}<li>{{ badge | strip | escape }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div>
        <img class="tu-unity__logo" src="{{ unity_logo }}" alt="Tueste Unity" width="700" height="242" loading="eager">
        <p class="tu-lead">{{ section.settings.promise | escape }}</p>
      </div>
    </div>

    {%- if hero_checklist.size > 0 -%}
      <ul class="tu-unity__checklist" aria-label="Qué incluye Tueste Unity">
        {%- for item in hero_checklist -%}
          <li><span class="tu-unity__checklist-icon" aria-hidden="true">✓</span>{{ item | strip | escape }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="tu-unity__paths" id="caminos">
      {%- for block in path_blocks -%}
        <article class="tu-unity__path{% if block.settings.featured %} tu-unity__path--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.featured -%}<span class="tu-unity__path-badge">Recomendado</span>{%- endif -%}
          <span class="tu-kicker">{{ block.settings.kicker | escape }}</span>
          <h2>{{ block.settings.title | escape }}</h2>
          <p>{{ block.settings.description | escape }}</p>
          <dl class="tu-unity__path-specs">
            <div><dt>Café</dt><dd>{{ block.settings.coffee_spec | escape }}</dd></div>
            <div><dt>Bolsa</dt><dd>{{ block.settings.bag_spec | escape }}</dd></div>
            <div><dt>Mínimo</dt><dd>{{ block.settings.minimum_spec | escape }}</dd></div>
            {%- if block.settings.includes != blank -%}<div><dt>Incluye</dt><dd>{{ block.settings.includes | escape }}</dd></div>{%- endif -%}
          </dl>
          <a class="tu-button {% if block.settings.featured %}tu-button--primary{% else %}tu-button--ghost{% endif %}" href="#taller" data-path-jump="{{ block.id }}">{{ block.settings.cta_label | escape }} <span aria-hidden="true">→</span></a>
        </article>
      {%- endfor -%}
    </div>
  </div>

  <div class="tu-wrap tu-section" id="taller">
    <div class="tu-home-block__heading"><div><p class="tu-kicker">Taller de brief</p><h2>Una primera versión de tu universo.</h2></div><p class="tu-lead">Configura una dirección inicial. El equipo la revisa contigo antes de convertirla en producción.</p></div>
    <div class="tu-unity__workbench">
      <div class="tu-panel tu-unity__wizard" data-unity-wizard>
        <div class="tu-unity__step" data-step="0">
          <h3><span class="tu-unity__step-number" aria-hidden="true">1</span> El camino</h3>
          <div class="tu-unity__step-options" data-config="path" role="group" aria-label="Camino">
            {%- for block in path_blocks -%}
              <button type="button" class="tu-unity__option" data-path-option="{{ block.id }}" data-title="{{ block.settings.title | escape }}" data-min="{{ block.settings.minimum_qty }}" data-qty-step="{{ block.settings.qty_step }}" data-unit="{{ block.settings.qty_unit | escape }}" data-color="{{ block.settings.bag_color }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
                <strong>{{ block.settings.title | escape }}</strong><small>desde {{ block.settings.minimum_spec | escape }}</small>
              </button>
            {%- endfor -%}
          </div>
        </div>

        <div class="tu-unity__step" data-step="1" hidden>
          <h3><span class="tu-unity__step-number" aria-hidden="true">2</span> Marca en la bolsa</h3>
          <label>Nombre de tu marca o empresa<input type="text" data-config="company" maxlength="40" placeholder="Ej. Casa Niebla" autocomplete="organization"></label>
          <div class="tu-unity__field">
            <p class="tu-unity__field-label" id="TuUnityLogoLabel-{{ section.id }}">Logo para la vista previa (opcional, no se envía ni se almacena)</p>
            <div class="tu-unity__upload">
              <label class="tu-button tu-button--ghost" for="TuUnityLogo-{{ section.id }}">Subir logo</label>
              <input type="file" id="TuUnityLogo-{{ section.id }}" accept="image/png,image/jpeg,image/svg+xml,image/webp" hidden data-logo-input aria-labelledby="TuUnityLogoLabel-{{ section.id }}" aria-describedby="TuUnityLogoHint-{{ section.id }}">
              <span class="tu-unity__hint" id="TuUnityLogoHint-{{ section.id }}" data-logo-hint>PNG o SVG con fondo transparente se ve mejor.</span>
              <button type="button" class="tu-button tu-button--ghost" data-logo-clear hidden aria-label="Quitar el logo subido">Quitar</button>
            </div>
          </div>
        </div>

        <div class="tu-unity__step" data-step="2" hidden>
          <h3><span class="tu-unity__step-number" aria-hidden="true">3</span> La taza</h3>
          <p class="tu-unity__hint">Elige la atmósfera de tu marca. Es el punto de partida de la catación, no la receta final.</p>
          <div class="tu-unity__step-options" data-config="mood" role="group" aria-label="Atmósfera" data-mood-options></div>
          <div class="tu-unity__profile" aria-live="polite">
            <div class="tu-unity__notes" data-mood-notes></div>
            <div class="tu-unity__bars" data-mood-bars></div>
          </div>
        </div>

        <div class="tu-unity__step" data-step="3" hidden>
          <h3><span class="tu-unity__step-number" aria-hidden="true">4</span> La firma sonora</h3>
          <p class="tu-unity__hint">Tu firma nace de las letras de tu nombre: cada una cae en una nota. Elige el timbre y escúchala.</p>
          <div class="tu-unity__step-options" data-config="timbre" role="group" aria-label="Timbre" data-timbre-options></div>
          <div class="tu-unity__play-row">
            <button type="button" class="tu-button tu-button--primary" data-play-signature><span aria-hidden="true">▶</span> Escuchar mi firma</button>
            <span class="tu-unity__notes-read" data-notes-read aria-live="polite"></span>
          </div>
          <p class="tu-form__message" data-audio-status role="status"></p>
        </div>

        <div class="tu-unity__step" data-step="4" hidden>
          <h3><span class="tu-unity__step-number" aria-hidden="true">5</span> Volumen</h3>
          <div class="tu-unity__stepper" role="group" aria-label="Cantidad de bolsas">
            <button type="button" data-qty-minus aria-label="Reducir la cantidad de bolsas">−</button>
            <input type="number" data-config="quantity" min="50" max="5000" step="10" value="100" inputmode="numeric" aria-label="Cantidad de bolsas">
            <button type="button" data-qty-plus aria-label="Aumentar la cantidad de bolsas">+</button>
          </div>
          <p class="tu-unity__hint" data-qty-hint>Mínimo del camino: 50 bolsas.</p>
          <label class="tu-form__check"><input type="checkbox" data-config="trees"><span>Quiero sumar árboles de Tueste Tree a mi edición (regalo para mi equipo o mis clientes).</span></label>
          <p class="tu-unity__hint" data-trees-hint hidden>Cada árbol lleva nombre, número y certificado. <a data-trees-link href="#siembra">Conocer Tueste Tree →</a></p>
        </div>

        <div class="tu-unity__step" data-step="5" hidden id="contacto">
          <h3><span class="tu-unity__step-number" aria-hidden="true">6</span> Habla con un asesor</h3>
          <p class="tu-unity__hint">Envíanos el brief o continúa la conversación por WhatsApp con el resumen listo.</p>
          <div data-unity-form>
            {%- form 'contact', id: form_id, class: 'tu-form' -%}
              <input type="hidden" name="contact[Origen]" value="Tueste Unity">
              <input type="hidden" name="contact[Brief]" data-brief-field value="">
              {%- if form.posted_successfully? -%}<p class="tu-form__message tu-form__message--success" role="status">{{ section.settings.success_message | escape }}</p>{%- endif -%}
              {%- if form.errors -%}<div class="tu-form__message tu-form__message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
              <div class="tu-form__row"><label>Tu nombre<input type="text" name="contact[Nombre]" required autocomplete="name" value="{{ form.name | escape }}"></label><label>Empresa<input type="text" name="contact[Empresa]" required data-contact-company></label></div>
              <div class="tu-form__row"><label>Teléfono<input type="tel" name="contact[Teléfono]" required autocomplete="tel"></label><label>Ciudad<input type="text" name="contact[Ciudad]" required autocomplete="address-level2"></label></div>
              <label>Correo<input type="email" name="contact[email]" required autocomplete="email" value="{{ form.email | escape }}"></label>
              <div class="tu-form__row">
                <label for="TuUnityWhen-{{ section.id }}">¿Para cuándo lo necesitas?
                  <select id="TuUnityWhen-{{ section.id }}" name="contact[Cuándo]">
                    <option value="Este mes">Este mes</option>
                    <option value="1 a 3 meses" selected>1-3 meses</option>
                    <option value="Más de 3 meses">+3 meses</option>
                    <option value="Solo estoy explorando">Solo explorando</option>
                  </select>
                </label>
                <fieldset class="tu-unity__pill-group">
                  <legend>Eres</legend>
                  <label class="tu-unity__pill"><input type="radio" name="contact[Eres]" value="Una marca" checked><span>Una marca</span></label>
                  <label class="tu-unity__pill"><input type="radio" name="contact[Eres]" value="Una empresa"><span>Una empresa</span></label>
                  <label class="tu-unity__pill"><input type="radio" name="contact[Eres]" value="Una persona"><span>Una persona</span></label>
                </fieldset>
              </div>
              <label>Mensaje<textarea name="contact[body]" rows="5" data-contact-message>{{ form.body | escape }}</textarea></label>
              <label class="tu-form__check"><input type="checkbox" name="contact[Consentimiento]" value="Acepto el contacto de Tueste Unity" required><span>Acepto que Tueste (Monacua Global Company S.A.S.) use estos datos para responder a esta solicitud.</span></label>
              <button class="tu-button tu-button--primary" type="submit">Enviar brief <span aria-hidden="true">→</span></button>
            {%- endform -%}
          </div>
          <div class="tu-hero__actions">
            <a class="tu-button tu-button--ghost" data-whatsapp-link href="https://wa.me/{{ section.settings.whatsapp_number | remove: ' ' | remove: '+' }}" target="_blank" rel="noopener">Abrir WhatsApp</a>
            <a class="tu-button tu-button--ghost" data-email-link href="mailto:{{ section.settings.contact_email | escape }}">Escribir por correo</a>
          </div>
        </div>

        <div class="tu-unity__wizard-nav">
          <button type="button" class="tu-button tu-button--ghost" data-wizard-prev>← Atrás</button>
          <div class="tu-unity__dots" data-wizard-dots role="group" aria-label="Progreso del taller"></div>
          <button type="button" class="tu-button tu-button--primary" data-wizard-next>Siguiente →</button>
        </div>
      </div>

      <aside class="tu-panel" aria-live="polite">
        <h2>Así se ve el brief</h2>
        <div class="tu-bag-preview" data-bag-preview>
          <div class="tu-unity-bag" data-unity-bag aria-hidden="true">
            <div class="tu-unity-bag__fold"></div>
            <div class="tu-unity-bag__body">
              <div class="tu-unity-bag__texture"></div>
              <div class="tu-unity-bag__valve"></div>
              <div class="tu-unity-bag__label">
                <img data-logo-preview hidden alt="" width="140" height="70">
                <span class="tu-unity-bag__brand" data-bag-label>Tu marca</span>
                <span class="tu-unity-bag__meta" data-bag-meta>Café de origen</span>
              </div>
            </div>
            <div class="tu-unity-bag__seam"></div>
          </div>
          <span class="tu-bag-preview__stamp" data-bag-stamp>Vista previa · <strong>Tu sello, rápido</strong></span>
        </div>
        <dl class="tu-config-summary">
          <div><dt>Camino</dt><dd data-summary="path">—</dd></div>
          <div><dt>Marca</dt><dd data-summary="company">—</dd></div>
          <div><dt>Logo</dt><dd data-summary="logo">Sin logo por ahora</dd></div>
          <div><dt>Taza</dt><dd data-summary="mood">—</dd></div>
          <div><dt>Firma sonora</dt><dd data-summary="signature">—</dd></div>
          <div><dt>Volumen</dt><dd data-summary="quantity">—</dd></div>
          <div><dt>Tueste Tree</dt><dd data-summary="trees">No por ahora</dd></div>
        </dl>
      </aside>
    </div>
  </div>

  <div class="tu-wrap tu-section" id="sonoro">
    <div class="tu-unity__sound">
      <div class="tu-unity__sound-art" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div>
        <p class="tu-kicker">Branding sonoro</p>
        <h2 class="tu-unity__sound-title">{{ section.settings.sound_title }}</h2>
        <p class="tu-lead">{{ section.settings.sound_lead | escape }}</p>
        <ul class="tu-unity__feature-list">
          <li>
            <span class="tu-unity__feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h2M7 8v8M11 5v14M15 9v6M19 11v2"/></svg></span>
            <div><strong>{{ section.settings.sound_feature_1_title | escape }}</strong><span>{{ section.settings.sound_feature_1_body | escape }}</span></div>
          </li>
          <li>
            <span class="tu-unity__feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/></svg></span>
            <div><strong>{{ section.settings.sound_feature_2_title | escape }}</strong><span>{{ section.settings.sound_feature_2_body | escape }}</span></div>
          </li>
          <li>
            <span class="tu-unity__feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg></span>
            <div><strong>{{ section.settings.sound_feature_3_title | escape }}</strong><span>{{ section.settings.sound_feature_3_body | escape }}</span></div>
          </li>
          <li>
            <span class="tu-unity__feature-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3"/></svg></span>
            <div><strong>{{ section.settings.sound_feature_4_title | escape }}</strong><span>{{ section.settings.sound_feature_4_body | escape }}</span></div>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="tu-wrap tu-section" id="proceso">
    <div class="tu-home-block__heading"><div><p class="tu-kicker">Cómo trabajamos</p><h2 class="tu-unity__sound-title">{{ section.settings.proceso_title }}</h2></div></div>
    <ol class="tu-unity__timeline">
      {%- for block in timeline_blocks -%}
        <li class="tu-unity__timeline-item" {{ block.shopify_attributes }}>
          <span class="tu-unity__timeline-number">{{ forloop.index }}</span>
          <span class="tu-unity__timeline-when">{{ block.settings.when | escape }}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.description | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
    <div class="tu-unity__terms">
      <div><strong>Pago</strong><span>{{ section.settings.terms_payment | escape }}</span></div>
      <div><strong>Despacho</strong><span>{{ section.settings.terms_dispatch | escape }}</span></div>
      <div><strong>Envío</strong><span>{{ section.settings.terms_shipping | escape }}</span></div>
      <div><strong>Garantía</strong><span>{{ section.settings.terms_warranty | escape }}</span></div>
    </div>
  </div>

  <div class="tu-wrap tu-section" id="experiencias">
    <div class="tu-unity__crew-head">
      <p class="tu-kicker">Experiencias · Tueste Crew</p>
      <h2 class="tu-unity__sound-title">{{ section.settings.crew_title }}</h2>
      <p class="tu-lead">{{ section.settings.crew_lead | escape }}</p>
      {%- if crew_range.size > 0 -%}
        <ul class="tu-unity__chip-list" aria-label="Lo que hacemos">
          {%- for item in crew_range -%}<li>{{ item | strip | escape }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="tu-unity__format-grid">
      <article class="tu-unity__format-card">
        <span class="tu-unity__crew-flag">100 % Tueste Crew</span>
        <h3>{{ section.settings.crew_format_1_title | escape }}</h3>
        <p>{{ section.settings.crew_format_1_body | escape }}</p>
        <a class="tu-button tu-button--ghost" href="{{ crew_wa_1_href }}" target="_blank" rel="noopener">Cotizar esta cata</a>
      </article>
      <article class="tu-unity__format-card">
        <span class="tu-unity__crew-flag">100 % Tueste Crew</span>
        <h3>{{ section.settings.crew_format_2_title | escape }}</h3>
        <p>{{ section.settings.crew_format_2_body | escape }}</p>
        <a class="tu-button tu-button--ghost" href="{{ crew_wa_2_href }}" target="_blank" rel="noopener">Cotizar esta fiesta</a>
      </article>
    </div>
    <div class="tu-unity__quote-cta">
      <div><strong>{{ section.settings.crew_quote_title | escape }}</strong><span>{{ section.settings.crew_quote_body | escape }}</span></div>
      <a class="tu-button tu-button--primary" href="{{ crew_wa_3_href }}" target="_blank" rel="noopener">Cotizar mi experiencia</a>
    </div>
  </div>

  <div class="tu-wrap tu-section" id="siembra">
    <div class="tu-unity__siembra">
      <img class="tu-unity__siembra-badge" src="{{ tree_badge_image }}" alt="Insignia holográfica de Tueste Tree, para 30 árboles o más" loading="lazy" width="440" height="607">
      <div>
        <p class="tu-kicker">Tueste Tree × Unity</p>
        <h2 class="tu-unity__sound-title">{{ section.settings.siembra_title }}</h2>
        <p class="tu-lead">{{ section.settings.siembra_lead | escape }}</p>
        <div class="tu-hero__actions">
          <a class="tu-button tu-button--primary" href="{{ tree_wa_href }}" target="_blank" rel="noopener">Hablar con el agente</a>
          <a class="tu-button tu-button--ghost" href="{{ tree_url | escape }}">Conocer Tueste Tree</a>
        </div>
      </div>
    </div>
  </div>

  <script src="{{ 'tueste-unity.js' | asset_url }}" defer></script>
</section>

{% schema %}
{
  "name": "Tueste Unity",
  "tag": "section",
  "class": "section-tueste-unity",
  "limit": 1,
  "settings": [
    { "type": "inline_richtext", "id": "title", "label": "Título", "default": "Tu café, <em>tu firma.</em>" },
    { "type": "textarea", "id": "intro", "label": "Introducción", "default": "Tueste Unity convierte el café de origen en una herramienta de marca: empaque, fórmula, contenido y una firma sonora que la gente recuerda." },
    { "type": "textarea", "id": "promise", "label": "Promesa", "default": "Una propuesta hecha a la medida, con el mismo origen que sostiene todo el Universo Tueste." },
    { "type": "text", "id": "primary_cta", "label": "CTA principal", "default": "Configurar una idea" },
    { "type": "text", "id": "paths_cta_label", "label": "CTA secundario del hero", "default": "Ver los tres caminos" },
    { "type": "textarea", "id": "hero_badges", "label": "Datos de confianza del hero, separados por ||", "default": "89 puntos SCA||Cañón de Aures · 1.840 msnm||Tostado al pedido · 15 días||Firma sonora incluida" },
    { "type": "textarea", "id": "hero_checklist", "label": "Checklist del hero, separado por ||", "default": "Logo en la 1840||Fórmula propia||Empaque completo||Firma sonora||Experiencias Tueste Crew" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp con código de país", "default": "573102690145" },
    { "type": "text", "id": "tree_whatsapp_number", "label": "WhatsApp del agente Tueste Tree", "default": "573102682677" },
    { "type": "text", "id": "contact_email", "label": "Correo de contacto", "default": "tuesteunity@tueste.co" },
    { "type": "text", "id": "success_message", "label": "Mensaje de éxito", "default": "Recibimos tu brief. Te contactaremos para darle forma." },
    { "type": "inline_richtext", "id": "sound_title", "label": "Sonoro · título", "default": "El café <em>también se escucha</em>" },
    { "type": "textarea", "id": "sound_lead", "label": "Sonoro · introducción", "default": "Grabamos los sonidos reales del café en el origen y con ellos componemos la voz de tu marca." },
