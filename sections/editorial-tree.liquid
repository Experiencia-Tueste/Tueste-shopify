{%- liquid
  assign tree_image = section.settings.image
  assign tree_image_asset = 'tueste-tree-hero-vitral.webp' | asset_url
  assign tree_alt = tree_image.alt | default: 'Tueste Tree'
-%}

<section class="tueste-editorial-tree section section--padding" id="{{ section.settings.anchor | escape }}">
  <div class="page-width">
    <div class="tueste-editorial-tree__shell">
      <div class="tueste-editorial-tree__heading">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="tueste-editorial-tree__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.body != blank -%}<div class="tueste-editorial-tree__lead rte">{{ section.settings.body }}</div>{%- endif -%}
      </div>

      {%- if section.blocks != blank -%}
        <div class="tueste-editorial-tree__stats">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div {{ block.shopify_attributes }}><strong>{{ block.settings.value | escape }}</strong><span>{{ block.settings.label | escape }}</span></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="tueste-editorial-tree__body">
        <div class="tueste-editorial-tree__media">
          {%- if tree_image != blank -%}
            {{ tree_image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1600', sizes: '(max-width: 767px) 100vw, 55vw', alt: tree_alt }}
          {%- else -%}
            <img src="{{ tree_image_asset }}" alt="{{ tree_alt | escape }}" loading="lazy" width="960" height="537">
          {%- endif -%}
          {%- if section.settings.media_note != blank -%}<span>{{ section.settings.media_note | escape }}</span>{%- endif -%}
        </div>
        <div class="tueste-editorial-tree__steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <article {{ block.shopify_attributes }}><span>{{ block.settings.number | escape }}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="tueste-editorial-tree__footer">
        {%- if section.settings.button_label != blank -%}<a class="button button--primary" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }} ↗</a>{%- endif -%}
        {%- if section.settings.disclaimer != blank -%}<p>{{ section.settings.disclaimer | escape }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .tueste-editorial-tree__shell { background: #27222e; color: #fffdf9; border-radius: 1.5rem; padding: clamp(1.5rem, 5vw, 4.5rem); }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__heading { display: grid; grid-template-columns: 1.1fr .9fr; gap: 5rem; align-items: end; }
  #shopify-section-{{ section.id }} h2 { margin: 0; color: #fffdf9; font-size: clamp(2.8rem, 6vw, 6.6rem); line-height: .98; letter-spacing: -.055em; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__eyebrow { color: rgba(255,253,249,.62); font: .7rem/1.2 monospace; letter-spacing: .12em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__lead { color: rgba(255,253,249,.72); font-size: 1.05rem; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 3rem 0 2rem; border-block: 1px solid rgba(255,253,249,.22); }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__stats div { padding: 1.4rem 0; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__stats div + div { padding-left: 1.5rem; border-left: 1px solid rgba(255,253,249,.22); }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__stats strong { display: block; color: #f2a51c; font-size: 2rem; font-weight: 500; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__stats span { color: rgba(255,253,249,.62); font-size: .75rem; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__body { display: grid; grid-template-columns: 1.05fr .95fr; gap: 5rem; align-items: center; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__media { position: relative; overflow: hidden; min-height: 28rem; border-radius: 1rem; background: #352b39; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__media img, #shopify-section-{{ section.id }} .tueste-editorial-tree__media svg { width: 100%; height: 100%; min-height: 28rem; object-fit: cover; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__media span { position: absolute; right: 1rem; bottom: 1rem; border: 1px solid rgba(255,255,255,.35); border-radius: 99px; padding: .45rem .65rem; background: rgba(39,34,46,.7); font: .6rem/1 monospace; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__steps { display: grid; gap: 1.6rem; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__steps article { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding-bottom: 1.4rem; border-bottom: 1px solid rgba(255,253,249,.18); }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__steps article > span { color: #f2a51c; font: .75rem/1 monospace; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__steps h3 { margin: 0 0 .4rem; color: #fffdf9; font-size: 1.35rem; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__steps p { margin: 0; color: rgba(255,253,249,.62); font-size: .85rem; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__footer { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-top: 3rem; }
  #shopify-section-{{ section.id }} .tueste-editorial-tree__footer p { margin: 0; color: rgba(255,253,249,.55); font-size: .75rem; }
  @media screen and (max-width: 767px) { #shopify-section-{{ section.id }} .tueste-editorial-tree__heading, #shopify-section-{{ section.id }} .tueste-editorial-tree__body { display: block; } #shopify-section-{{ section.id }} .tueste-editorial-tree__lead { margin-top: 1.5rem; } #shopify-section-{{ section.id }} .tueste-editorial-tree__stats { gap: .5rem; } #shopify-section-{{ section.id }} .tueste-editorial-tree__stats strong { font-size: 1.35rem; } #shopify-section-{{ section.id }} .tueste-editorial-tree__stats span { font-size: .65rem; } #shopify-section-{{ section.id }} .tueste-editorial-tree__media { min-height: 18rem; margin-bottom: 2rem; } #shopify-section-{{ section.id }} .tueste-editorial-tree__media img, #shopify-section-{{ section.id }} .tueste-editorial-tree__media svg { min-height: 18rem; } #shopify-section-{{ section.id }} .tueste-editorial-tree__footer { display: block; } #shopify-section-{{ section.id }} .tueste-editorial-tree__footer p { margin-top: 1rem; } }
</style>

{% schema %}
{
  "name": "Tueste Tree editorial",
  "tag": "section",
  "class": "section-editorial-tree",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "tree" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "02 / Tueste Tree" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Adopta un árbol. Escucha su origen." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>No compras una planta: entras a un origen vivo.</p>" },
    { "type": "image_picker", "id": "image", "label": "Tree image" },
    { "type": "text", "id": "media_note", "label": "Media note", "default": "Datos operativos en validación" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Conocer la adopción" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Adopción simbólica y cultural · no representa inversión financiera." }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "settings": [ { "type": "text", "id": "value", "label": "Value", "default": "1.840 m" }, { "type": "text", "id": "label", "label": "Label", "default": "Altitud · Cañón de Aures" } ] },
    { "type": "step", "name": "Step", "settings": [ { "type": "text", "id": "number", "label": "Number", "default": "01" }, { "type": "text", "id": "title", "label": "Title", "default": "Adopta tu árbol" }, { "type": "textarea", "id": "text", "label": "Text", "default": "Una experiencia simbólica vinculada a un lote de origen." } ] }
  ],
  "presets": [ { "name": "Tueste Tree editorial", "blocks": [ { "type": "stat" }, { "type": "stat", "settings": { "value": "300", "label": "Árboles · Lote 000" } }, { "type": "stat", "settings": { "value": "01", "label": "Adopción simbólica" } }, { "type": "step" }, { "type": "step", "settings": { "number": "02", "title": "Recibe tu constancia", "text": "Obtén un identificador digital y la historia del lote." } }, { "type": "step", "settings": { "number": "03", "title": "Sigue su cosecha", "text": "Recibe las actualizaciones que el equipo pueda documentar." } } ] } ]
}
{% endschema %}
