{%- comment -%}
  Tueste Records · Lista del sello. Formulario nativo de clientes de Shopify (etiqueta "newsletter" + "tueste-records").
{%- endcomment -%}
{{ 'tueste-records.css' | asset_url | stylesheet_tag }}

{%- assign form_id = 'TuesteRecordsForm-' | append: section.id -%}

<div class="tu-records" id="TuesteRecordsSuscribete-{{ section.id }}">
  <section class="tr-section sub" id="suscribete" aria-labelledby="TuesteRecordsSuscribeteTitle-{{ section.id }}">
    <div class="wrap">
      <div>
        <span class="eyebrow">{{ section.settings.kicker | escape }}</span>
        <h2 id="TuesteRecordsSuscribeteTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.text | escape }}</p>
      </div>
      <div>
        {%- form 'customer', id: form_id, class: 'tr-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter, tueste-records">
          <input type="hidden" name="contact[context]" value="tueste-records">
          <label class="visually-hidden" for="{{ form_id }}-email">{{ section.settings.placeholder | escape }}</label>
          <input id="{{ form_id }}-email" type="email" name="contact[email]" value="{{ form.email }}" required autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="{{ section.settings.placeholder | escape }}">
          <button type="submit">{{ section.settings.button_label | escape }}</button>
          {%- if form.errors and form.context == 'tueste-records' -%}
            <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <div class="ok" role="status">{{ section.settings.success | escape }}</div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
    {%- if section.settings.show_backed -%}
      <div class="wrap wrap-backed">
        <div class="backed">
          <div class="lp"><span>Respaldado por</span><strong class="backed-mark">Logik Pro</strong><span>· {{ section.settings.backed_text | escape }}</span></div>
          <span>© {{ 'now' | date: '%Y' }} Tueste Records</span>
        </div>
      </div>
    {%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "Records · Lista del sello",
  "tag": "section",
  "class": "section-tueste-records-suscribete",
  "limit": 1,
  "settings": [
    { "type": "paragraph", "content": "Usa el formulario nativo de clientes de Shopify: cada correo queda como cliente con las etiquetas newsletter y tueste-records." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Lista del sello" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Entérate antes que las plataformas" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Lanzamientos exclusivos, sesiones en vivo y preguardado antes de la fecha oficial. Un correo por lanzamiento, nada más." },
    { "type": "text", "id": "placeholder", "label": "Placeholder del correo", "default": "tu@correo.com" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Unirme" },
    { "type": "text", "id": "success", "label": "Mensaje de éxito", "default": "Listo. Te escribimos con el próximo lanzamiento." },
    { "type": "checkbox", "id": "show_backed", "label": "Mostrar respaldo de Logik Pro", "default": true },
    { "type": "text", "id": "backed_text", "label": "Texto del respaldo", "default": "Sello registrado en plataformas digitales desde 2012" }
  ],
  "presets": [
    { "name": "Tueste Records · Lista del sello" }
  ]
}
{% endschema %}
