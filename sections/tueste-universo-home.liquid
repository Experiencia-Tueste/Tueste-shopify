{{ 'tienda-editorial.css' | asset_url | stylesheet_tag }}
{{ 'universo-tueste.css' | asset_url | stylesheet_tag }}

<div class="te-preview tueste-home" id="tueste-universo-home-{{ section.id }}" data-tree-total="{{ section.settings.tree_total }}">
  <main id="inicio">
    <section class="te-preview__hero" data-hero aria-roledescription="carrusel" aria-label="Tueste en portada">
      <article class="te-preview__slide is-active" data-slide aria-label="1 de 4 · Origen">
        <div class="te-preview__hero-bg" style="background-image:url('{{ 'tueste-tree-hero-vitral.webp' | asset_url }}')" aria-hidden="true"></div>
        <div class="te-preview__wrap te-preview__hero-copy">
          <span class="te-preview__eyebrow">01 / Music, art &amp; coffee</span>
          <h1>{{ section.settings.hero_title }}</h1>
          <p class="te-preview__lead">{{ section.settings.hero_body }}</p>
          <div class="te-preview__actions">
            <a class="te-preview__button" href="#cafe">{{ section.settings.hero_primary_label }}</a>
            <a class="te-preview__button te-preview__button--secondary" href="#tree">{{ section.settings.hero_secondary_label }}</a>
          </div>
        </div>
      </article>

      <article class="te-preview__slide" data-slide aria-label="2 de 4 · Tueste Tree" aria-hidden="true">
        <div class="te-preview__hero-bg" style="background-image:url('{{ 'tueste-tree-siembra-vitral.webp' | asset_url }}');background-position:center 45%" aria-hidden="true"></div>
        <div class="te-preview__wrap te-preview__hero-copy">
          <span class="te-preview__eyebrow">02 / Tueste Tree</span>
          <h1>Siembra un árbol. <em>Cofunda un origen</em>.</h1>
          <p class="te-preview__lead">Los primeros {{ section.settings.tree_total }} árboles son fundacionales. Eliges tu lugar en el lote, lo siembras y sigues su año completo.</p>
          <div class="te-preview__actions">
            <a class="te-preview__button" href="{{ section.settings.tree_url }}">Entrar a la finca</a>
            <a class="te-preview__button te-preview__button--secondary" href="#insignias">Ver las insignias</a>
          </div>
          <div class="te-preview__founders">
            <div class="te-preview__founders-num"><span>Fundadores de Tueste Tree</span><span><b data-taken>{{ section.settings.tree_taken }}</b> de {{ section.settings.tree_total }}</span></div>
            <div class="te-preview__meter"><i data-meter style="width:0"></i></div>
          </div>
        </div>
      </article>

      <article class="te-preview__slide te-preview__slide--banner" data-slide aria-label="3 de 4 · Piezas limitadas" aria-hidden="true">
        <div class="te-preview__hero-bg" style="background-image:url('{{ 'banner_hodie.png' | asset_url }}');background-position:center 50%" aria-hidden="true"></div>
        <div class="te-preview__wrap te-preview__hero-copy">
          <span class="te-preview__eyebrow">03 / Piezas limitadas</span>
          <div class="te-preview__actions"><a class="te-preview__button" href="#piezas">Comprar el hoodie</a><a class="te-preview__button te-preview__button--secondary" href="#piezas">Ver todas las piezas</a></div>
        </div>
      </article>

      <article class="te-preview__slide te-preview__slide--banner" data-slide aria-label="4 de 4 · Tueste Records" aria-hidden="true">
        <div class="te-preview__hero-bg" style="background-image:url('{{ 'banner_lanzamiento.png' | asset_url }}');background-position:center 50%" aria-hidden="true"></div>
        <div class="te-preview__wrap te-preview__hero-copy">
          <span class="te-preview__eyebrow">04 / Tueste Selection · Tueste Records</span>
          <div class="te-preview__actions"><a class="te-preview__button" href="#records">Ver el lanzamiento</a><a class="te-preview__button te-preview__button--secondary" href="#records">Entrar al sello</a></div>
        </div>
      </article>

      <div class="te-preview__hero-controls">
        <div class="te-preview__hero-dots" data-hero-dots role="tablist" aria-label="Diapositivas"></div>
        <button class="te-preview__hero-arrow" type="button" data-hero-prev aria-label="Anterior">‹</button>
        <button class="te-preview__hero-arrow" type="button" data-hero-next aria-label="Siguiente">›</button>
      </div>
    </section>

    <div class="te-preview__marquee" aria-label="Donde el café se escucha">
      <div class="te-preview__marquee-track"><span>Donde el café se escucha · </span><span aria-hidden="true">Donde el café se escucha · </span><span aria-hidden="true">Donde el café se escucha · </span><span aria-hidden="true">Donde el café se escucha · </span></div>
    </div>

    <section class="te-preview__section">
      <div class="te-preview__wrap te-preview__intro te-preview__reveal">
        <div><span class="te-preview__eyebrow">Tueste / Editorial</span><h2>{{ section.settings.intro_title }}</h2></div>
        <div><p>En <strong>Tueste</strong> el café no se sirve, se interpreta. Cultivamos café colombiano de origen en el cañón de Aures y lo convertimos en música, ritual y comunidad.</p><p>Aquí compras café fresco, siembras un árbol y sigues su cosecha, o vives una experiencia sensorial donde el origen suena antes de llegar a la taza.</p></div>
      </div>
    </section>

    <section class="te-preview__section" id="cafe">
      <div class="te-preview__wrap te-preview__reveal">
        <div class="te-preview__section-heading te-preview__heading-row"><div><span class="te-preview__eyebrow">02 / Café de origen</span><h2>El café que <em>abre la escucha</em>.</h2><p>Los lotes de la colección Aures, en todas sus presentaciones. Cada bolsa trae el QR musical de su lote.</p></div><div class="te-preview__rail-nav"><button class="te-preview__arrow" type="button" data-rail-prev="cafes" aria-label="Anterior">‹</button><button class="te-preview__arrow" type="button" data-rail-next="cafes" aria-label="Siguiente">›</button></div></div>
        <div class="te-preview__rail" data-rail="cafes" tabindex="0" aria-label="Presentaciones de café">
          {% for block in section.blocks %}
            {% if block.type == 'coffee' %}
              {%- assign selected_product = block.settings.product -%}
              {%- case forloop.index -%}
                {%- when 1 -%}{%- assign fallback_image = 'aures-conscious.png' -%}
                {%- when 2 -%}{%- assign fallback_image = 'aures-amour.png' -%}
                {%- when 3 -%}{%- assign fallback_image = 'combo-unity.png' -%}
                {%- when 4 -%}{%- assign fallback_image = 'combo-taza.jpg' -%}
                {%- else -%}{%- assign fallback_image = 'combo-sonora.jpg' -%}
              {%- endcase -%}
              <article class="te-preview__cafe" {{ block.shopify_attributes }}>
                <div class="te-preview__cafe-art">{% # theme-check-disable RemoteAsset %}<img src="{% if selected_product != blank and selected_product.featured_image != blank %}{{ selected_product.featured_image | image_url: width: 900 }}{% else %}{{ fallback_image | asset_url }}{% endif %}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="675">{% # theme-check-enable RemoteAsset %}</div>
                <div class="te-preview__cafe-body"><span class="te-preview__meta">{{ block.settings.meta }}</span><h3>{% if selected_product != blank %}{{ selected_product.title }}{% else %}{{ block.settings.title }}{% endif %}</h3><p class="te-preview__card-note">{{ block.settings.description }}</p><p class="te-preview__card-price">{% if selected_product != blank %}{{ selected_product.price | money }}{% else %}{{ block.settings.price }}{% endif %}</p><a class="te-preview__button" href="{% if selected_product != blank %}{{ selected_product.url }}{% else %}#cafe{% endif %}">{{ block.settings.cta }}</a></div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="te-preview__section" id="piezas"><div class="te-preview__wrap te-preview__reveal"><div class="te-preview__section-heading"><span class="te-preview__eyebrow">03 / Piezas · Café · Ritual</span><h2>Objetos <em>con origen</em>.</h2></div><div class="te-preview__cards">
      <article class="te-preview__card"><div class="te-preview__card-image"><img src="{{ 'taza-rosada.png' | asset_url }}" alt="Taza efímero rosada" loading="lazy" width="900" height="900"></div><div class="te-preview__card-body"><h3>Taza efímero rosada</h3><p class="te-preview__card-price">$145.000 COP</p><p class="te-preview__card-note">Pieza limitada, torneada a mano.</p><a class="te-preview__button te-preview__button--secondary" href="#piezas">Ver pieza</a></div></article>
      <article class="te-preview__card"><div class="te-preview__card-image"><img src="{{ 'taza-morada.png' | asset_url }}" alt="Taza efímero morada" loading="lazy" width="900" height="900"></div><div class="te-preview__card-body"><h3>Taza efímero morada</h3><p class="te-preview__card-price">$145.000 COP</p><p class="te-preview__card-note">Pieza limitada, torneada a mano.</p><a class="te-preview__button" href="#piezas">Comprar</a></div></article>
      <article class="te-preview__card"><div class="te-preview__card-image"><img src="{{ 'taza-splash.png' | asset_url }}" alt="Taza Splash" loading="lazy" width="900" height="900"></div><div class="te-preview__card-body"><h3>Taza Splash</h3><p class="te-preview__card-price">$145.000 COP</p><p class="te-preview__card-note">Pieza única, hecha a mano.</p><a class="te-preview__button" href="#piezas">Comprar</a></div></article>
      <article class="te-preview__card"><div class="te-preview__card-image"><img src="{{ 'hoodie.png' | asset_url }}" alt="Origin Grey Hoodie" loading="lazy" width="900" height="900"></div><div class="te-preview__card-body"><h3>Origin Grey Hoodie</h3><p class="te-preview__card-price">$380.000 COP</p><p class="te-preview__card-note">Edición limitada 1840-LTD.</p><a class="te-preview__button" href="#piezas">Comprar</a></div></article>
    </div></div></section>

    <section class="te-preview__section" id="tree"><div class="te-preview__wrap te-preview__reveal"><div class="te-preview__section-heading"><span class="te-preview__eyebrow">04 / Tueste Tree</span><h2>Siembra un árbol. <em>Cofunda un origen</em>.</h2><p>Los primeros {{ section.settings.tree_total }} árboles son fundacionales. No compras una planta: entras a un origen vivo y lo sigues durante todo un año.</p></div><div class="te-preview__tree-shell"><div class="te-preview__tree-media"><img src="{{ 'tueste-tree-siembra-vitral.webp' | asset_url }}" alt="Manos sembrando una plántula de café bajo la lluvia" loading="lazy" width="1200" height="900"><span>Finca Tres Esquinas · Lote fundacional</span></div><div class="te-preview__tree-copy"><h3>Tu nombre queda en la tierra.</h3><p>Eliges tu lugar en el lote, siembras tu árbol en pantalla y recibes tu Certificado de Tradición numerado.</p><ul class="te-preview__facts"><li><span>Valor</span><span>Precio configurado en el producto Tree</span></li><li><span>En línea</span><span>De 1 a 30 árboles · más de 30, con nuestro agente</span></li><li><span>Insignia</span><span>Semilla, Plata, Oro u Holográfica según cuántos siembres</span></li></ul><div class="te-preview__founders"><div class="te-preview__founders-num"><span>Ya sembraron</span><span><b data-taken>{{ section.settings.tree_taken }}</b> de {{ section.settings.tree_total }}</span></div><div class="te-preview__meter"><i data-meter style="width:0"></i></div></div><div class="te-preview__actions"><a class="te-preview__button" href="{{ section.settings.tree_url }}">Entrar a la finca</a><a class="te-preview__button te-preview__button--secondary" href="#insignias">Ver las insignias</a></div><p class="te-preview__disclaimer">Adopción simbólica y cultural · no representa inversión financiera.</p></div></div></div></section>

    <section class="te-preview__section" id="insignias"><div class="te-preview__wrap te-preview__reveal"><div class="te-preview__section-heading"><span class="te-preview__eyebrow">05 / Las insignias del proyecto</span><h2>Cuatro acabados, <em>un mismo origen</em>.</h2><p>Cada adopción recibe su insignia digital. El acabado cambia según cuántos árboles siembres.</p></div><div class="te-preview__badges">
      {% assign badges = 'tueste-tree-insignia-1-semilla.webp|Semilla|1 – 9,tueste-tree-insignia-10-plata.webp|Plata|10 – 19,tueste-tree-insignia-20-oro.webp|Oro|20 – 29,tueste-tree-insignia-30-holografica.webp|Holográfica|30+' | split: ',' %}
      {% for badge in badges %}{% assign parts = badge | split: '|' %}<article class="te-preview__badge"><img src="{{ parts[0] | asset_url }}" alt="Insignia {{ parts[1] }}" loading="lazy" width="600" height="600"><p class="te-preview__badge-q">{{ parts[2] }}<small>Árboles</small></p><p class="te-preview__badge-name">{{ parts[1] }}</p><p class="te-preview__badge-desc">Una marca visual del origen que estás ayudando a cultivar.</p></article>{% endfor %}
    </div></div></section>

    <section class="te-preview__section" id="vivir"><div class="te-preview__wrap te-preview__reveal"><div class="te-preview__section-heading"><span class="te-preview__eyebrow">06 / Vivir el café</span><h2>Tu árbol te va a escribir. <em>Y tú vas a estar ahí</em>.</h2><p>Cuatro capítulos a lo largo del año, cada uno con algo que te llega.</p></div><div class="te-preview__chapters">
      {% assign chapters = 'tueste-tree-cap1-lluvia.webp|La primera lluvia|Un brote de dos hojas a 1.840 m, envuelto en la niebla del cañón.,tueste-tree-cap2-flor.webp|La noche en que florece|Tres días de flores blancas y olor a jazmín sobre toda la ladera.,tueste-tree-cap3-cosecha.webp|Cuando enrojece|Las cerezas pasan de verde a rojo y se recogen a mano.,tueste-tree-cap4-taza.webp|La taza con tu nombre|El lote vuelve tostado a las manos del guardián que lo sembró.' | split: ',' %}
      {% for chapter in chapters %}{% assign parts = chapter | split: '|' %}<article class="te-preview__chapter"><div class="te-preview__chapter-art"><img src="{{ parts[0] | asset_url }}" alt="{{ parts[1] }}" loading="lazy" width="900" height="900"></div><p class="te-preview__chapter-n">Capítulo {{ forloop.index }}</p><h3>{{ parts[1] }}</h3><p>{{ parts[2] }}</p><div class="te-preview__chapter-get"><span>Te llega</span>Actualización editorial del lote y su frecuencia.</div></article>{% endfor %}
    </div></div></section>

    <section class="te-preview__section" id="ritual"><div class="te-preview__wrap te-preview__reveal"><div class="te-preview__section-heading"><span class="te-preview__eyebrow">07 / Tueste Sessions 001</span><h2>El café también <em>se escucha</em>.</h2><p><em>Coffee in Frequencies</em> es el primer álbum de Origen Tostado: una frecuencia que recorre el viaje de la semilla hasta la expansión.</p></div><div class="te-preview__panel"><div class="te-preview__panel-image"><a href="{{ section.settings.spotify_url }}" target="_blank" rel="noopener"><img src="{{ 'banner_2.png' | asset_url }}" alt="Tueste Sessions 001" loading="lazy" width="1200" height="800"></a></div><div><h3>Coffee in Frequencies · Origen Tostado</h3><p>Más que música, un paisaje sonoro grabado con los sonidos reales del café. La misma frecuencia vive en el QR de cada bolsa.</p><div class="te-preview__actions"><a class="te-preview__button" href="{{ section.settings.spotify_url }}" target="_blank" rel="noopener">Escuchar en Spotify</a><a class="te-preview__button te-preview__button--secondary" href="#records">Todas las plataformas</a></div></div></div></div></section>

    <section class="te-preview__section" id="unity"><div class="te-preview__wrap te-preview__unity te-preview__reveal"><div class="te-preview__unity-art" aria-hidden="true"><img src="{{ 'tueste-unity-logo.png' | asset_url }}" alt="" loading="lazy" width="700" height="242"></div><div><span class="te-preview__eyebrow">08 / Tueste Unity</span><h2>Tu marca de café, <em>con firma sonora</em>.</h2></div><div><p><strong>Tueste Unity</strong> es nuestro estudio creativo y de branding sonoro para marcas de café: co-branding, firma sonora, contenido y experiencias.</p><p class="te-preview__quote">Curamos música electrónica y creamos canciones con sonidos reales del café, grabados en el origen.</p><div class="te-preview__actions"><a class="te-preview__button" href="{{ section.settings.unity_url }}">Conoce Tueste Unity</a></div></div></div></section>
    <section class="te-preview__section" id="records"><div class="te-preview__wrap te-preview__unity te-preview__reveal"><div class="te-preview__unity-art te-preview__records-art" aria-hidden="true"><img src="{{ 'banner_lanzamiento.png' | asset_url }}" alt="" loading="lazy" width="1800" height="1013"></div><div><span class="te-preview__eyebrow">09 / Tueste Records</span><h2>El café también <em>se publica</em>.</h2></div><div><p><strong>Tueste Records</strong> es el sello discográfico de Tueste: lanzamientos, artistas y frecuencias creadas con sonidos reales del origen.</p><p class="te-preview__quote">Cada lote tiene su música. Cada lanzamiento, su café.</p><div class="te-preview__actions"><a class="te-preview__button" href="{{ section.settings.records_url }}">Entrar al sello</a><a class="te-preview__button te-preview__button--secondary" href="{{ section.settings.records_url }}#plataformas">Dónde escuchar</a></div></div></div></section>
  </main>

  {% render 'universo-tueste', current: 'tienda' %}
</div>

<script src="{{ 'tueste-universo-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Universo Tueste · portada",
  "tag": "section",
  "class": "tueste-universo-home-section",
  "settings": [
    { "type": "text", "id": "hero_title", "label": "Título hero", "default": "Café colombiano de origen, hecho música." },
    { "type": "textarea", "id": "hero_body", "label": "Texto hero", "default": "Tueste interpreta el café desde el territorio: origen, ritual, sonido y comunidad. Aquí el café se escucha antes de probarse." },
    { "type": "text", "id": "hero_primary_label", "label": "CTA principal", "default": "Comprar café" },
    { "type": "text", "id": "hero_secondary_label", "label": "CTA secundario", "default": "Sembrar un árbol" },
    { "type": "text", "id": "intro_title", "label": "Título editorial", "default": "Del origen a la taza, con intención." },
    { "type": "number", "id": "tree_taken", "label": "Árboles fundadores", "default": 3570 },
    { "type": "number", "id": "tree_total", "label": "Meta de árboles", "default": 10200 },
    { "type": "url", "id": "tree_url", "label": "URL Tueste Tree" },
    { "type": "url", "id": "unity_url", "label": "URL Tueste Unity" },
    { "type": "url", "id": "records_url", "label": "URL Tueste Records" },
    { "type": "url", "id": "spotify_url", "label": "URL Spotify", "default": "https://open.spotify.com" }
  ],
  "blocks": [
    { "type": "coffee", "name": "Café", "settings": [
      { "type": "product", "id": "product", "label": "Producto Shopify" },
      { "type": "text", "id": "title", "label": "Título de respaldo", "default": "Aures 1840 Conscious" },
      { "type": "text", "id": "meta", "label": "Meta", "default": "Lote 01 · 340 g" },
      { "type": "textarea", "id": "description", "label": "Descripción", "default": "Panela, cereza madura y cacao. Grano entero o molido, tueste medio." },
      { "type": "text", "id": "price", "label": "Precio de respaldo", "default": "$55.000 COP" },
      { "type": "text", "id": "cta", "label": "CTA", "default": "Comprar" }
    ] }
  ],
  "presets": [{ "name": "Universo Tueste · portada", "blocks": [{ "type": "coffee" }, { "type": "coffee" }, { "type": "coffee" }, { "type": "coffee" }, { "type": "coffee" }] }]
}
{% endschema %}
